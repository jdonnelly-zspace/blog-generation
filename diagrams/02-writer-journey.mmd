%% Lanes run left-to-right, which is the shape Lucid's cross-functional
%% (swimlane) container expects. Rebuild the three subgraphs as lanes after import.
flowchart LR
  subgraph W["Writer"]
    W1["Types /blog<br/>from any folder"]
    W2["Answers discovery<br/>topic, keyword, takeaways, category, author"]
    W3["Approves<br/>the SEO plan"]
    W4["Reads the<br/>review PDF"]
    W5["Approves<br/>publish"]
    W6["Shares the<br/>public URL"]
  end

  subgraph C["Claude Code — zspace-blog skill"]
    P0["Pre-flight<br/>update check, token, Python + reportlab"]
    P0b["Loads guidelines<br/>voice, writing rules, schema"]
    P1["Phase 1<br/>Discovery"]
    P2["Phase 2<br/>Content plan"]
    P3["Phase 3<br/>Write HTML + metadata"]
    P4a["Phase 4a<br/>Branded review PDF"]
    P4b["Phase 4b<br/>Validate every link"]
    P5["Phase 5<br/>Publish, link category, verify"]
    P6["Phase 6<br/>File image task"]
  end

  subgraph X["Systems"]
    CH["Chrome MCP<br/>SPA 404 detection"]
    D["Directus<br/>mkt_blog"]
    J["Jira ZW<br/>assigned to creative"]
    B["blog.zspace.com"]
  end

  W1 --> P0 --> P0b --> P1 --> W2 --> P2 --> W3
  W3 -->|"revise"| P2
  W3 -->|"approved"| P3
  P3 --> P4a --> W4 --> W5
  P3 --> P4b --> CH
  CH -->|"broken link — fix and recheck"| P4b
  P4b -->|"all links good"| W5
  W5 -->|"approved"| P5 --> D --> B
  P5 --> P6 --> J
  P6 --> W6
  W6 -.->|"change to draft or reschedule"| P5

flowchart TB
  subgraph GH["GitHub — single source of truth"]
    REPO["blog-generation<br/>public repo"]
    SKILL["SKILL.md<br/>the 6-phase workflow"]
    GUIDE["guidelines/<br/>voice, writing rules, schema, tokens"]
    SCRIPTS["scripts/<br/>install, update, setup_roles"]
  end

  subgraph LOCAL["Writer's machine"]
    CLONE["~/zspace/blog-generation<br/>git clone"]
    LINK["~/.claude/skills/zspace-blog<br/>symlink — makes /blog global"]
    ENV[".env<br/>personal token, gitignored"]
    CC["Claude Code<br/>runs the skill"]
    PY["Python + reportlab<br/>review PDF"]
    DRAFTS["drafts/<br/>html, json, pdf — local only"]
  end

  subgraph EXT["External systems"]
    DIR["Directus CMS<br/>admin.zspace.com"]
    CHROME["Claude in Chrome MCP<br/>real-browser link checks"]
    ZS["zspace.com<br/>Angular SPA — link targets"]
    JIRA["Jira ZW<br/>image request task"]
    BLOG["blog.zspace.com<br/>public output"]
  end

  GH ==>|"clone once, pull thereafter"| CLONE
  CLONE --> LINK --> CC
  ENV --> CC
  CLONE -. "pre-flight: fetch, offer ff-only pull" .-> CC
  CC --> PY --> DRAFTS
  CC --> DRAFTS
  CC -->|"REST — POST, GET, PATCH"| DIR
  CC -->|"MCP — navigate and verify"| CHROME
  CHROME --> ZS
  CC -->|"MCP — createJiraIssue"| JIRA
  DIR --> BLOG
